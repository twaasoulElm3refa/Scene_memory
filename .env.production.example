# Production settings for Scemory. Template only: copy the values you need into
# the server's existing .env by hand and keep every secret that is already there.
# Keys not listed here keep their .env.example meaning. Never commit a real .env.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://scemory.com
APP_KEY=                      # keep the existing key; changing it breaks sessions and encrypted data
LOG_CHANNEL=stack
LOG_STACK=daily               # rotated files instead of one growing log
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis is required for Cache::tags(); without it tagged pages are computed uncached.
CACHE_STORE=redis
CACHE_PREFIX=scemory_cache_
# Turn on only after `php artisan scemory:production-check` shows cache.tags OK:
# GET /up then fails (HTTP 500) whenever the cache store cannot tag.
CACHE_REQUIRE_TAGS=false
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=1260  # must stay above the longest job timeout (video: 1200 s)
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp

# PayPal: keep the live values that already work. The webhook bridge on
# alimconsultancy.com forwards to the existing routes; nothing here changes it.
PAYPAL_MODE=live
PAYPAL_VERIFY_WEBHOOKS=true
PAYPAL_ALLOW_LOCAL_WEBHOOK_BYPASS=false

# Withdrawal fee charged by the server (requesters can no longer choose it).
# 0/0 keeps today's behaviour of no fee; set only with business approval.
WALLET_WITHDRAWAL_FEE_FIXED_MINOR=0
WALLET_WITHDRAWAL_FEE_BPS=0

FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
